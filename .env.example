# Model provider configuration: copy to `.env` and fill in your own API keys.
# This file is a safe TEMPLATE and is committed; the real `.env` is gitignored.
#
# The engine talks to any OpenAI-compatible /chat/completions endpoint. Configure at
# least one provider. Configure two if you want a cheap "fast" model and a strong "smart"
# model routed to different roles (see engine/providers/config.py).

# --- DeepSeek (cheap, fast) -----------------------------------------------------------------
DEEPSEEK_API_KEY="sk-your-deepseek-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# --- Moonshot / Kimi (strong reasoning) -----------------------------------------------------
# International endpoint is .ai (.cn for mainland China).
# MOONSHOT_API_KEY="sk-your-moonshot-key-here"
# MOONSHOT_BASE_URL="https://api.moonshot.ai/v1"
# MOONSHOT_MODEL="kimi-k2"

# --- Optional: any other OpenAI-compatible provider (e.g. Zhipu, ZenMux, OpenRouter) --------
# ZHIPU_API_KEY="your-key-here"
# ZENMUX_API_KEY="your-key-here"

# --- Role routing (optional) ----------------------------------------------------------------
# Which configured provider plays which role when you use build_router_from_env():
#   AGENT_SMART_PROVIDER - the reasoning-heavy work
#   AGENT_FAST_PROVIDER  - fast hot-path calls
# AGENT_SMART_PROVIDER="moonshot"
# AGENT_FAST_PROVIDER="deepseek"

# Per-completion token cap (default 8192; set 0 for the provider default). Overridable
# per provider as e.g. DEEPSEEK_MAX_TOKENS.
# AGENT_MAX_TOKENS="8192"

# --- Audit log signing (optional) -----------------------------------------------------------
# BARK_SQK_AUDIT_SIGNING_KEY="your-ed25519-private-key-pem"

